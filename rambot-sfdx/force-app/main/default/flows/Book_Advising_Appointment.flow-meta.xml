<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Confirmation</name>
        <label>Set Confirmation</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>found</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>ConfirmationNumber</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_New_Appointments.Name</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Slot_Error</name>
        <label>Set Slot Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>slotError</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Not booked: appointments must be on a future weekday (Monday to Friday) and start between 9:00 AM and 5:00 PM Eastern Time.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Application_Found</name>
        <label>Application Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Not Found</defaultConnectorLabel>
        <rules>
            <name>Rcord_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Find_Application</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Valid_Time_Slot</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Valid_Time_Slot</name>
        <label>Valid Time Slot?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Slot_Error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Invalid Slot</defaultConnectorLabel>
        <rules>
            <name>Valid_Slot</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>isValidSlot</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Appointments</targetReference>
            </connector>
            <label>Valid Slot</label>
        </rules>
    </decisions>
    <description>V2: rejects bookings that are not on a future weekday between 9 AM and 5 PM Eastern Time; returns slotError instead of creating a record.</description>
    <environments>Default</environments>
    <formulas>
        <description>appointmentTime shifted to US Eastern Time (read with GMT-based DATEVALUE/TIMEVALUE).</description>
        <name>appointmentTimeET</name>
        <dataType>DateTime</dataType>
        <expression>{!appointmentTime} - ({!etOffsetHours} / 24)</expression>
    </formulas>
    <formulas>
        <description>Hours to subtract from UTC to get US Eastern Time for appointmentTime (4 during daylight saving, otherwise 5).</description>
        <name>etOffsetHours</name>
        <dataType>Number</dataType>
        <expression>IF(AND(DATEVALUE({!appointmentTime} - 5/24) &gt;= DATE(YEAR(DATEVALUE({!appointmentTime} - 5/24)), 3, 8) + MOD(8 - WEEKDAY(DATE(YEAR(DATEVALUE({!appointmentTime} - 5/24)), 3, 8)), 7), DATEVALUE({!appointmentTime} - 5/24) &lt; DATE(YEAR(DATEVALUE({!appointmentTime} - 5/24)), 11, 1) + MOD(8 - WEEKDAY(DATE(YEAR(DATEVALUE({!appointmentTime} - 5/24)), 11, 1)), 7)), 4, 5)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <description>True when appointmentTime is in the future, on a weekday, and starts between 9:00 AM and 5:00 PM Eastern Time.</description>
        <name>isValidSlot</name>
        <dataType>Boolean</dataType>
        <expression>AND(NOT(ISBLANK({!appointmentTime})), {!appointmentTime} &gt; NOW(), WEEKDAY(DATEVALUE({!appointmentTimeET})) &gt;= 2, WEEKDAY(DATEVALUE({!appointmentTimeET})) &lt;= 6, HOUR(TIMEVALUE({!appointmentTimeET})) &gt;= 9, HOUR(TIMEVALUE({!appointmentTimeET})) &lt; 17)</expression>
    </formulas>
    <interviewLabel>Book Advising Appointment {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Book Advising Appointment</label>
    <processMetadataValues>
