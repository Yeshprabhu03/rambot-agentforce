      try {
        embeddedservice_bootstrap.settings.language = 'en_US';
        embeddedservice_bootstrap.init(
          '00Dbm000017ak5Y',
          'RamBot_Web_Chat',
          'https://orgfarm-74f758c996-dev-ed.develop.my.site.com/ESWRamBotWebCha1794095724605',
          { scrt2URL: 'https://orgfarm-74f758c996-dev-ed.develop.my.salesforce-scrt.com' }
        );
      } catch (err) {
        console.error('Error loading Embedded Messaging: ', err);
      }
    };
  </script>
  <script type='text/javascript' src='https://orgfarm-74f758c996-dev-ed.develop.my.site.com/ESWRamBotWebCha1794095724605/assets/js/bootstrap.min.js' onload='initEmbeddedMessaging()'></script>
